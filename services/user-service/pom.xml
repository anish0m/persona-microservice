<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
      Note what the parent is here: NOT spring-boot-starter-parent directly,
      but our own aggregator pom. Version and java.version are inherited from
      it, which is how every service stays in lockstep automatically.
    -->
    <parent>
        <groupId>com.persona</groupId>
        <artifactId>persona-microservices</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <!-- Only artifactId is needed - groupId and version come from the parent. -->
    <artifactId>user-service</artifactId>
    <name>user-service</name>
    <description>Owns everything about a persona user: identity, profile, credentials</description>

    <dependencies>
        <!-- Boot 4 names: `-webmvc` / `-webmvc-test`. In 3.x these were `-web` / `-test`. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Day-05. Bean validation (Hibernate Validator) for @NotBlank / @Email /
          @Size on the request DTOs.

          The annotations compile without this jar and are then read by nobody:
          no error, no log line, a green build, zero validation. Present but not
          participating, for the fourth time in this project.

          WORTH MORE HERE THAN IN THE MONOLITH. In the monolith, an unvalidated
          field eventually hits the model's requireText or a NOT NULL column and
          fails somewhere in the same process. In a microservice the natural
          next step is that this service passes the value to ANOTHER service,
          and the failure surfaces over there — in a log nobody watching this
          deployment is reading, attributed to the wrong team.

          Validate at YOUR OWN boundary. A service does not get to assume its
          caller validated, even when its caller is also you.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          Day-05. BCrypt only — deliberately NOT spring-boot-starter-security.

          spring-security-crypto is a plain library: PasswordEncoder,
          BCryptPasswordEncoder, nothing auto-configured and no filter chain.
          The starter would lock every endpoint behind a login form that does
          not exist yet and turn the existing tests red. Login is Day-06.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!--
          Day-06. The wide dependency, added deliberately and late — see the
          monolith's pom for the full reasoning. It installs the filter chain
          that Day-05 spent a comment explaining why it did NOT want yet.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
          Day-06, piece 1. jjwt: issues and validates JWTs. Same three-artifact
          split as the monolith (api / impl-runtime / jackson-runtime) — see
          that pom for the reasoning. Not spring-boot-starter-security yet;
          this piece only needs email-in, signed-string-out and back.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!--
          Day-03. JDBC, a connection pool (HikariCP), JdbcClient, and Spring's
          DataSource auto-configuration. NOT spring-boot-starter-data-jpa — there
          is no Hibernate here, no @Entity, no magic. We write the SQL.

          That is deliberate. Day-04 adds JPA, and it should arrive as a
          labour-saving device over something already understood, not as the
          only way you have ever seen a row reach an object.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!--
          Day-04. JPA — and note that this dependency is IDENTICAL to the
          monolith's. Persistence is the layer where the two architectures agree
          most completely: an entity is an entity, and Hibernate does not know or
          care how many services are deployed.

          Where they will diverge is Day-17, and it is worth naming now: in a
          microservice, an @Entity may only describe tables THIS service owns.
          The moment an entity here holds a @ManyToOne to something owned by
          another service, the object graph crosses a database boundary that does
          not exist — and JPA will happily let you write it. The annotation
          cannot tell you that your architecture is wrong.

          Brings Hibernate 7 (implementation), Jakarta Persistence (spec) and
          Spring Data JPA (convenience). Still spring-boot-starter-data-jpa in
          Boot 4 — this one was NOT renamed, unlike -web -> -webmvc.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
          The PostgreSQL driver: the code that actually speaks Postgres's wire
          protocol over a socket. <scope>runtime</scope> because nothing we write
          imports org.postgresql — we compile against java.sql interfaces, and
          the driver is only needed when the program runs.

          That scope is the three-layer rule expressed in the build file: if this
          were <scope>compile</scope>, nothing would STOP a class from importing
          the vendor directly.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          Flyway. Versioned, ordered, immutable SQL migrations that run
          automatically at startup.

          The alternative is a human typing CREATE TABLE into a terminal once,
          which means the schema exists only in production and in that person's
          memory. With Flyway the schema is CODE: in git, reviewed, and identical
          on every machine. It records each applied migration in a
          flyway_schema_history table, so running the app twice does not run the
          migration twice.

          flyway-database-postgresql is a separate artifact since Flyway 10 —
          the core no longer bundles per-database support.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!--
          SPRING BOOT 4 CHANGE, and it cost real debugging time.

          In Boot 3, flyway-core on the classpath was enough: the auto-
          configuration lived in the single spring-boot-autoconfigure jar and
          switched itself on. Boot 4 split that jar into per-technology modules,
          so FlywayAutoConfiguration now ships in spring-boot-flyway.

          The failure mode is what makes this worth a comment. Nothing errored.
          Flyway was on the classpath, the migration was on the classpath, and
          the application started perfectly — it simply never ran the migration
          and never logged a word about it. The symptom appeared one layer away
          as  relation "users" does not exist.

          How it was found: the classpath was searched for the class itself
          (unzip -l over every spring-boot jar) rather than trusting that the
          dependency being present meant the feature was active. Worth
          remembering — "the jar is there" and "the auto-configuration exists"
          are different claims.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
              This plugin lives in the MODULE, not the aggregator - because the
              module is what gets packaged into a runnable jar. The aggregator
              produces nothing runnable.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
              Surefire runs *Test by default and ignores *IT. That default is
              good — it keeps `mvn test` fast and free of infrastructure — but
              it means JdbcUserRepositoryIT would never run at all.

              So we add *IT to the includes, and the class itself carries
              @EnabledIfSystemProperty(named = "it", matches = "true"). The
              result:

                  mvn test              30 fast tests, no database needed
                  mvn test -Dit=true    those plus the real SQL against Postgres

              The guard lives in the test rather than in a Maven profile so that
              the reason it skipped is visible in the test report, instead of the
              class silently not existing.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
